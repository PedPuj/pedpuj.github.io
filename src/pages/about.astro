---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { aboutImage } from '../data/catalog';
import { site, aboutText, aboutPhotoSlot } from '../data/site';
---

<Base title="About" ground="#F5F2EC">
  <SiteHeader />

  <main id="main" class="about">
    <div class="portrait">
      {
        aboutImage ? (
          <Image
            src={aboutImage}
            alt={aboutPhotoSlot}
            widths={[500, 900]}
            sizes="(max-width: 768px) 100vw, 30vw"
            loading="eager"
            data-fade
          />
        ) : (
          <span class="slot">
            {import.meta.env.DEV && <span class="mono slot-note">{aboutPhotoSlot}</span>}
          </span>
        )
      }
    </div>

    <div class="text">
      {aboutText.map((paragraph) => <p>{paragraph}</p>)}

      <div class="mono contact">
        <span>{site.camera}</span>
        <span>{site.films}</span>
        <span>{site.email.toUpperCase()}</span>
      </div>

      <p class="links">
        <a href={site.instagram} rel="me noopener" target="_blank">Instagram</a>
        <a href={`mailto:${site.email}`}>Email</a>
      </p>
    </div>
  </main>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    padding: 88px var(--margin) 120px;
  }

  .portrait {
    grid-column: span 4;
    height: 520px;
    background: var(--block);
    overflow: hidden;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--block);
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .portrait :global(img.is-loaded) {
    opacity: 1;
  }

  .slot {
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100%;
  }

  .slot-note {
    padding: 12px 14px;
    color: var(--ink-2);
    font-size: 10px;
  }

  .text {
    grid-column: 6 / span 5;
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 60ch;
  }

  .text p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
  }

  .contact {
    display: flex;
    flex-direction: column;
    padding-top: 8px;
    border-top: 1px solid var(--hairline);
    color: var(--ink-2);
    line-height: 2;
  }

  .links {
    display: flex;
    gap: 24px;
    font-size: 16px;
  }

  .links a {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--hairline);
    transition: text-decoration-color 150ms ease;
  }

  .links a:hover {
    text-decoration-color: var(--ink);
  }

  @media (max-width: 768px) {
    .about {
      display: block;
      padding: 48px var(--margin) 80px;
    }

    .portrait {
      height: 420px;
      margin-bottom: 32px;
    }

    .text {
      max-width: none;
    }
  }
</style>
