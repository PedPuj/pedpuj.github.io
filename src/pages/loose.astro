---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { looseFrames } from '../data/catalog';
---

<Base title="Loose" ground="#F5F2EC">
  <SiteHeader />

  <main id="main" class="loose">
    <p class="mono lead">LOOSE — FRAMES THAT DIDN'T MAKE A SERIES</p>

    <div class="sheet">
      {
        looseFrames.map((frame) => (
          <a class="thumb" href={frame.href}>
            {frame.image ? (
              <Image
                src={frame.image}
                alt={frame.slot}
                widths={[300, 600]}
                sizes="(max-width: 768px) 33vw, 256px"
                loading="lazy"
                data-fade
                transition:name={frame.id}
              />
            ) : (
              <span class="slot" />
            )}
          </a>
        ))
      }
    </div>
  </main>
</Base>

<style>
  .loose {
    padding: 0 var(--margin) 120px;
  }

  .lead {
    margin-bottom: 40px;
    color: var(--ink-2);
  }

  /* The only grid on the site. */
  .sheet {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }

  .thumb {
    display: block;
    aspect-ratio: 3 / 2;
    background: var(--block);
    overflow: hidden;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--block);
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .thumb :global(img.is-loaded) {
    opacity: 1;
  }

  .slot {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--block);
  }

  @media (max-width: 768px) {
    .sheet {
      grid-template-columns: repeat(3, 1fr);
    }
    .loose {
      padding-bottom: 80px;
    }
  }
</style>
