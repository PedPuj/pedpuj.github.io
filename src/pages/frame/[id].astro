---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { allFrames, getSeries, counterText } from '../../data/catalog';

export function getStaticPaths() {
  return allFrames.map((frame) => ({ params: { id: frame.id }, props: { frame } }));
}

const { frame } = Astro.props;
const series = getSeries(frame.collection);

// Loose frames have no series, so they borrow the lightbox metadata grey.
const accent = series ? series.counterColor : '#8C877E';
const total = series ? series.frameCount : allFrames.filter((f) => f.collection === 'loose').length;
const backHref = series ? series.href : '/loose/';
const prevHref = frame.prev ? `/frame/${frame.prev}/` : null;
const nextHref = frame.next ? `/frame/${frame.next}/` : null;
const title = series ? `${series.title} ${frame.index}` : `Loose ${frame.index}`;

// The photograph is capped by HEIGHT, so its slot width is that cap times the
// aspect ratio. Both the CSS and the `sizes` hint below need to know it.
const ratio = frame.image
  ? frame.image.width / frame.image.height
  : frame.orientation === 'v'
    ? 2 / 3
    : 3 / 2;
const slotWidth = `${Math.round(88 * ratio)}vh`;
---

<Base title={title} ground="#141210" accent={accent}>
  <main
    id="main"
    class="lightbox"
    data-lightbox
    data-prev={prevHref}
    data-next={nextHref}
    data-back={backHref}
  >
    <div class="stage" style={`--ar: ${ratio}`}>
      {
        frame.image ? (
          <Image
            src={frame.image}
            alt={frame.slot}
            widths={[800, 1400, 2048]}
            sizes={`(max-width: 768px) 100vw, ${slotWidth}`}
            loading="eager"
            data-fade
            transition:name={frame.id}
          />
        ) : (
          <span class="slot" transition:name={frame.id} />
        )
      }
    </div>

    <div class="chrome" data-chrome>
      <span class="mono counter">{counterText(frame.index, total)}</span>
      <a class="close" href={backHref} aria-label="Close">✕</a>

      {prevHref && (
        <a
          class="arrow prev"
          href={prevHref}
          aria-label="Previous frame"
          data-astro-prefetch="hover"
        >
          ‹
        </a>
      )}
      {nextHref && (
        <a
          class="arrow next"
          href={nextHref}
          aria-label="Next frame"
          data-astro-prefetch="hover"
        >
          ›
        </a>
      )}

      <p class="mono meta">{frame.metadata}</p>
    </div>
  </main>
</Base>

<style>
  .lightbox {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100vw;
    min-height: 100vh;
    min-height: 100svh;
    background: var(--lightbox);
    overflow: hidden;
    /* The swipes below own every drag: nothing scrolls or rubber-bands under
       your finger. Pinch-to-zoom is left to the browser. */
    touch-action: pinch-zoom;
    overscroll-behavior: contain;
  }

  .stage {
    --cap: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Definite width, so the layout box comes from the height cap and the real
       proportions — not from whichever srcset rendition the browser picked. */
    width: min(calc(100vw - var(--margin) * 2), calc(var(--cap) * var(--ar)));
  }

  .stage :global(img) {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .stage :global(img.is-loaded) {
    opacity: 1;
  }

  .slot {
    display: block;
    width: 100%;
    aspect-ratio: var(--ar);
    background: #201d1a;
  }

  /* Half the photograph steps forward, half steps back — see the script. */
  @media (hover: hover) and (pointer: fine) {
    .stage {
      cursor: pointer;
    }
  }

  .chrome {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 1;
    transition: opacity 300ms ease;
  }

  .chrome a {
    pointer-events: auto;
  }

  .chrome.is-idle {
    opacity: 0;
  }

  .counter {
    position: absolute;
    top: 28px;
    right: 76px;
    font-size: 12px;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .close {
    position: absolute;
    top: 26px;
    right: 32px;
    font-size: 15px;
    line-height: 1;
    color: var(--lightbox-meta);
    transition: color 150ms ease;
  }

  .close:hover {
    color: var(--paper);
  }

  /* The mark is 22px of type, which is far too small to aim at. The target
     around it is 88 x 160 — the glyph still sits 28px in from the edge and
     centred, so nothing looks any different; there is just something there
     to hit. */
  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    width: 88px;
    height: 160px;
    font-size: 22px;
    line-height: 1;
    /* Deliberately low contrast. */
    color: rgba(245, 242, 236, 0.28);
    transition: color 150ms ease;
  }

  .arrow:hover {
    color: rgba(245, 242, 236, 0.6);
  }

  .prev {
    left: 0;
    justify-content: flex-start;
    padding-left: 28px;
  }

  .next {
    right: 0;
    justify-content: flex-end;
    padding-right: 28px;
  }

  .meta {
    position: absolute;
    bottom: 34px;
    left: var(--margin);
    color: var(--lightbox-meta);
  }

  @media (max-width: 768px) {
    .arrow {
      display: none;
    }

    .stage {
      --cap: 74svh;
    }

    .counter {
      top: 24px;
      right: 60px;
      font-size: 11px;
    }

    .close {
      top: 22px;
      right: 20px;
    }

    .meta {
      bottom: 26px;
      right: var(--margin);
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  function setupLightbox() {
    const root = document.querySelector<HTMLElement>('[data-lightbox]');
    if (!root) return;

    const chrome = root.querySelector<HTMLElement>('[data-chrome]');
    const prev = root.dataset.prev || null;
    const next = root.dataset.next || null;
    const back = root.dataset.back || '/';

    let timer: number | undefined;

    // Chrome fades away after three seconds of stillness.
    function wake() {
      chrome?.classList.remove('is-idle');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => chrome?.classList.add('is-idle'), 3000);
    }

    function onKey(event: KeyboardEvent) {
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.key === 'Escape') navigate(back);
      else if (event.key === 'ArrowLeft' && prev) navigate(prev);
      else if (event.key === 'ArrowRight' && next) navigate(next);
    }

    // Swipe: left/right between frames, down to close. It fires the moment
    // the threshold is crossed rather than waiting for you to lift your
    // finger, so the frame turns while the gesture still feels like one
    // movement instead of landing a beat late.
    let startX = 0;
    let startY = 0;
    let swiped = false;

    function onTouchStart(event: TouchEvent) {
      startX = event.changedTouches[0].clientX;
      startY = event.changedTouches[0].clientY;
      swiped = false;
    }

    function onTouchMove(event: TouchEvent) {
      if (swiped) return;
      const dx = event.changedTouches[0].clientX - startX;
      const dy = event.changedTouches[0].clientY - startY;

      if (Math.abs(dx) > 56 && Math.abs(dx) > Math.abs(dy)) {
        const to = dx < 0 ? next : prev;
        if (!to) return;
        swiped = true;
        navigate(to);
      } else if (dy > 72 && dy > Math.abs(dx)) {
        swiped = true;
        navigate(back);
      }
    }

    // Clicking the photograph steps through the sequence: its left half goes
    // back, its right half goes on. Clicking the ground around it closes.
    // Pointer devices only — on a phone the swipes above already do this, and
    // a stray tap should not throw you out of the frame.
    const stage = root.querySelector<HTMLElement>('.stage');

    function onClick(event: MouseEvent) {
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      const target = event.target;
      if (!(target instanceof Element)) return;
      // The close mark and the arrows say what they do; leave them to it.
      if (target.closest('a')) return;

      if (stage && stage.contains(target)) {
        const box = stage.getBoundingClientRect();
        const to = event.clientX > box.left + box.width / 2 ? next : prev;
        if (to) navigate(to);
        return;
      }

      navigate(back);
    }

    document.addEventListener('keydown', onKey);
    document.addEventListener('mousemove', wake);
    root.addEventListener('click', onClick);
    root.addEventListener('touchstart', onTouchStart, { passive: true });
    root.addEventListener('touchmove', onTouchMove, { passive: true });

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.clearTimeout(timer);
        document.removeEventListener('keydown', onKey);
        document.removeEventListener('mousemove', wake);
      },
      { once: true },
    );

    wake();
  }

  document.addEventListener('astro:page-load', setupLightbox);
</script>
