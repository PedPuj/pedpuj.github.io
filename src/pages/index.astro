---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import Nav from '../components/Nav.astro';
import { heroImage, heroSlot } from '../data/catalog';
import { site } from '../data/site';

// The hero is object-fit: cover over the whole viewport. On a portrait screen
// that scales the photograph by HEIGHT and crops the sides away, so the slot it
// really has to fill is 100vh x its aspect ratio — far wider than 100vw. Saying
// "100vw" there would have the browser fetch for the phone's width and then
// stretch it about 2.6x.
const heroRatio = heroImage ? heroImage.width / heroImage.height : 1.5;
const heroSizes = `(orientation: portrait) ${Math.round(heroRatio * 100)}vh, 100vw`;
---

<Base bodyClass="home">
  <main id="main" class="hero">
    {
      heroImage ? (
        <Image
          class="hero-img"
          src={heroImage}
          alt={heroSlot}
          widths={[900, 1400, 2000, 2800]}
          sizes={heroSizes}
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="hero-slot" />
      )
    }

    <div class="scrim scrim-top" aria-hidden="true"></div>
    <div class="scrim scrim-bottom" aria-hidden="true"></div>

    <div class="chrome-top">
      <Wordmark onPhoto />
      <Nav onPhoto />
    </div>

    <p class="mono chrome-bottom">{site.homeMonoLine}</p>
  </main>
</Base>

<style>
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--block);
  }

  .hero :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-slot {
    width: 100%;
    height: 100%;
    background: var(--block);
  }

  /* Legibility only: top and bottom, never more than 25% black. */
  .scrim {
    position: absolute;
    left: 0;
    right: 0;
    height: 180px;
    pointer-events: none;
  }

  .scrim-top {
    top: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.25), transparent);
  }

  .scrim-bottom {
    bottom: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.25), transparent);
  }

  .chrome-top {
    position: absolute;
    top: 34px;
    left: var(--margin);
    right: var(--margin);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .chrome-bottom {
    position: absolute;
    bottom: 34px;
    left: var(--margin);
    color: var(--paper);
  }

  @media (max-width: 768px) {
    .scrim {
      height: 140px;
    }
    .chrome-top {
      top: 26px;
    }
    .chrome-bottom {
      bottom: 26px;
    }
  }
</style>
