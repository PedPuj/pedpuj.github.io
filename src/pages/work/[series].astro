---
import Base from '../../layouts/Base.astro';
import SeriesHeader from '../../components/SeriesHeader.astro';
import SeriesRail from '../../components/SeriesRail.astro';
import ChapterMark from '../../components/ChapterMark.astro';
import FrameView from '../../components/Frame.astro';
import FramePair from '../../components/FramePair.astro';
import { allSeries, nextSeriesLine } from '../../data/catalog';
import type { Chapter, Frame } from '../../data/catalog';

export function getStaticPaths() {
  return allSeries.map((s) => ({ params: { series: s.slug }, props: { series: s } }));
}

const { series } = Astro.props;

// Which frame each chapter opens on, so the sequence knows where to break.
const opens = new Map<number, Chapter>(series.chapters.map((c) => [c.from, c]));

// The edit, laid out: a chapter mark wherever the journey moves on, and a
// frame marked `pair` sitting beside the one after it — unless that one
// starts a new city, in which case the pair is dropped rather than carried
// across the break.
interface Block {
  frames: Frame[];
  /** Set when this is the first group of a new city. */
  chapter?: Chapter;
}

const blocks: Block[] = [];
for (let i = 0; i < series.frames.length; i += 1) {
  const frame = series.frames[i];
  const chapter = opens.get(frame.index);
  const partner = series.frames[i + 1];

  let group: Frame[];
  if (frame.pair && partner && !opens.has(partner.index)) {
    group = [frame, partner];
    i += 1;
  } else {
    group = [frame];
  }

  blocks.push(chapter ? { frames: group, chapter } : { frames: group });
}

// A photograph that opens a city is held a little shorter, so its chapter
// line still fits on the same screen once the page has snapped to it.
const capOf = (block: Block, pair: boolean) =>
  pair
    ? block.chapter
      ? '46vh'
      : '56vh'
    : block.chapter
      ? '62vh'
      : '78vh';
const next = nextSeriesLine(series);
---

<Base title={series.title} ground={series.ground} accent={series.counterColor}>
  <SeriesHeader series={series} />
  {series.chapters.length > 0 && <SeriesRail series={series} />}

  <main id="main" class="series">
    <div class="sequence">
      {
        blocks.map((block, i) => {
          const pair = block.frames.length === 2;
          const view = pair ? (
            <FramePair
              frames={block.frames as [Frame, Frame]}
              treatment={series.treatment}
              eager={i === 0}
              cap={capOf(block, true)}
              anchor
            />
          ) : (
            <FrameView
              frame={block.frames[0]}
              treatment={series.treatment}
              eager={i === 0}
              maxHeight={capOf(block, false)}
              anchor
            />
          );

          // The city's name and its first photograph are one page: the frame
          // inside is still what the scroll settles on, and the line simply
          // rides above it.
          return block.chapter ? (
            <div class="opening">
              <ChapterMark chapter={block.chapter} />
              {view}
            </div>
          ) : (
            view
          );
        })
      }
    </div>

    {
      next && (
        <div class="next-wrap">
          <a class="mono next" href={next.href} data-astro-prefetch="hover">
            {next.text}
            <span class="next-rule" aria-hidden="true" />
          </a>
        </div>
      )
    }
  </main>
</Base>

<style>
  .sequence {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Roughly a quarter of the screen of empty paper between frames. */
    gap: 25vh;
    padding: 120px var(--margin) 0;
  }

  /* A city's name and its first photograph, held together as one page. */
  .opening {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 26px;
    width: 100%;
  }

  /* A little further to travel into a new city than between two frames
     of the same one. */
  .opening + :global(*),
  .sequence > .opening {
    margin-top: 6vh;
  }

  .sequence > .opening:first-child {
    margin-top: 0;
  }

  /* Nothing sets scroll-margin on a frame. It is tempting — it is how you
     normally keep an anchor clear of a sticky header — but scroll-margin
     grows the box the browser snaps to, so a margin at the top moves the
     snap position up and drops the photograph below where it was scrolled
     to: it settles, pauses, then shifts. The scroll-padding above holds the
     header clear for anchors instead, and leaves the snap box alone. */

  /* ── One photograph at a time ──────────────────────────────────
     The page stops on each frame rather than drifting between them.
     The scroll container is the document itself, so this has to reach
     out of the component — it ships only with the series page, and the
     padding holds the sticky header clear so a photograph settles in
     the middle of the paper below it rather than under the bar. */
  :global(html) {
    scroll-snap-type: y mandatory;
    scroll-padding-top: calc(var(--series-header-h) + var(--safe-top));
  }

  /* Every photograph is a stop, and so is the line out to the next series
     — without that last one, mandatory snapping would hold the bottom of
     the page permanently out of reach. */
  .sequence :global(.frame),
  .sequence :global(.pair),
  .next-wrap {
    scroll-snap-align: center;
  }

  /* An opening is one page, not two: the frame inside it is the stop, and
     the chapter line rides above. Without this the page could settle on
     the photograph alone and hide the name under the header. */
  .opening :global(.chapter) {
    scroll-snap-align: none;
  }

  .next-wrap {
    margin-top: 140px;
    padding: 0 var(--margin) 120px;
  }

  .next {
    position: relative;
    display: inline-block;
    color: var(--ink-2);
    transition: color 150ms ease;
  }

  .next:hover {
    color: var(--ink);
  }

  /* Draws left to right, as on the series index. */
  .next-rule {
    position: absolute;
    left: 0;
    bottom: -6px;
    display: block;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 250ms ease;
  }

  .next:hover .next-rule,
  .next:focus-visible .next-rule {
    width: 100%;
  }

  @media (max-width: 768px) {
    .sequence {
      gap: 18vh;
      padding-top: 72px;
    }

    .opening {
      gap: 18px;
    }

    .next-wrap {
      margin-top: 96px;
      padding-bottom: 80px;
    }
  }
</style>

<script>
  let releasing = 0;

  /**
   * Puts an element in the middle of the paper below the sticky header.
   *
   * Snapping has to be lifted while this runs. A smooth scroll that travels
   * past other photographs gives the browser snap points on the way, and it
   * will take one and abandon the rest of the journey — which is what made a
   * jump from the margin to a distant city simply not arrive. Anything
   * further than a couple of screens is not worth animating anyway: it is a
   * long smear of photographs nobody asked to see.
   */
  function centreOn(y: number) {
    const root = document.documentElement;
    const top = document.querySelector<HTMLElement>('.series-header')?.offsetHeight ?? 0;
    const target = y - (top + (window.innerHeight - top) / 2);
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const far = Math.abs(target - window.scrollY) > window.innerHeight * 2;

    root.style.scrollSnapType = 'none';
    window.clearTimeout(releasing);
    releasing = window.setTimeout(() => {
      root.style.removeProperty('scroll-snap-type');
    }, still || far ? 60 : 900);

    window.scrollTo({ top: target, behavior: still || far ? 'auto' : 'smooth' });
  }

  const centreOf = (el: HTMLElement) => {
    const box = el.getBoundingClientRect();
    return box.top + box.height / 2 + window.scrollY;
  };

  // One observer drives everything that answers to where you are reading:
  // the counter, the city in the header, the mark in the margin rail, and
  // the colour of the paper itself.
  function startCounter() {
    const counter = document.querySelector<HTMLElement>('[data-counter]');
    const number = document.querySelector<HTMLElement>('[data-counter-num]');
    const placeOut = document.querySelector<HTMLElement>('[data-counter-place]');
    const frames = Array.from(document.querySelectorAll<HTMLElement>('[data-frame]'));
    const marks = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
    if (!counter || !number || frames.length === 0) return;

    const total = counter.dataset.total ?? String(frames.length);
    const pad = (n: string) => n.padStart(3, '0');

    // The cities this series is actually told in, and the paper each one is
    // printed on, read off the chapter marks themselves. Both are empty on a
    // series without chapters — Japan moves between three cities every other
    // frame, and naming them in the corner would only flicker.
    const chaptered = new Set<string>();
    const grounds = new Map<string, string>();
    for (const mark of marks) {
      const place = mark.dataset.place;
      if (!place) continue;
      chaptered.add(place);
      if (mark.dataset.ground) grounds.set(place, mark.dataset.ground);
    }
    const root = document.documentElement;
    const base = root.style.getPropertyValue('--ground');

    let shownPlace: string | null = null;

    function showPlace(place: string | undefined) {
      const value = place ?? null;
      if (value === shownPlace) return;
      shownPlace = value;

      if (placeOut) placeOut.textContent = value ? `${value} · ` : '';

      if (grounds.size > 0) {
        root.style.setProperty('--ground', (value && grounds.get(value)) || base);
      }

      for (const city of document.querySelectorAll<HTMLElement>('.rail [data-place]')) {
        const here = city.dataset.place === value;
        city.classList.toggle('is-current', here);
        if (here) city.setAttribute('aria-current', 'true');
        else city.removeAttribute('aria-current');
      }
    }

    function show(el: HTMLElement | null | undefined) {
      if (!el) return;
      const index = el.dataset.index;
      if (index) number.textContent = `${pad(index)} / ${total}`;
      const place = el.dataset.place;
      showPlace(place && chaptered.has(place) ? place : undefined);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) show(entry.target as HTMLElement);
        }
      },
      // Fires as a photograph crosses the vertical centre of the viewport.
      { rootMargin: '-50% 0px -50% 0px' },
    );

    frames.forEach((frame) => observer.observe(frame));
    marks.forEach((mark) => observer.observe(mark));

    // The observer only ever hears about what crosses the middle of the
    // screen, so anything that arrives somewhere without scrolling past —
    // a link straight to a frame, a restored reading position, a jump from
    // the rail — would leave the counter reading whatever it read before.
    // This settles it by simply looking at what is on screen.
    function nearest(list: HTMLElement[]) {
      const middle = window.scrollY + window.innerHeight / 2;
      let best = Infinity;
      let chosen: HTMLElement | null = null;
      for (const el of list) {
        const distance = Math.abs(centreOf(el) - middle);
        if (distance < best) {
          best = distance;
          chosen = el;
        }
      }
      return chosen;
    }

    function sync() {
      show(nearest(frames));
      // A chapter mark can be closer than any photograph, and when it is,
      // it is the city you have just arrived in that should be named.
      const marker = nearest([...frames, ...marks]);
      const place = marker?.dataset.place;
      showPlace(place && chaptered.has(place) ? place : undefined);
    }

    let settle = 0;
    const onScroll = () => {
      window.clearTimeout(settle);
      settle = window.setTimeout(sync, 120);
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    sync();
    // Again once the photographs have taken up their real heights.
    const settled = window.setTimeout(sync, 400);

    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
        window.removeEventListener('scroll', onScroll);
        window.clearTimeout(settle);
        window.clearTimeout(settled);
        // The next page sets its own paper; don't carry a city's over.
        root.style.setProperty('--ground', base);
      },
      { once: true },
    );
  }

  // The itinerary in the left margin: every city is a real link to a real
  // anchor, so it works without this. With it, the frame is centred rather
  // than dropped under the header, and the page glides instead of jumping.
  function startRail() {
    const rail = document.querySelector<HTMLElement>('.rail');
    if (!rail) return;

    function onClick(event: MouseEvent) {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const city = target.closest<HTMLElement>('[data-goto]');
      if (!city || event.metaKey || event.ctrlKey || event.shiftKey) return;

      const frame = document.querySelector<HTMLElement>(
        `[data-frame][data-index="${city.dataset.goto}"]`,
      );
      if (!frame) return;

      event.preventDefault();
      centreOn(centreOf(frame));
    }

    rail.addEventListener('click', onClick);
    document.addEventListener(
      'astro:before-swap',
      () => rail.removeEventListener('click', onClick),
      { once: true },
    );
  }

  // ── Turning the pages ────────────────────────────────────────
  // The CSS above stops the page on each photograph, and on touch and on a
  // trackpad's momentum that is the whole job. A mouse wheel is another
  // matter: a photograph is most of a screen tall, so a notch or two never
  // travels past the halfway mark between two frames and the page simply
  // springs back where it was — it reads as though the site is stuck. So the
  // wheel is taken over here. Any gesture, however small, turns exactly one
  // page, and the snapping underneath goes on handling everything else.
  function startPaging() {
    const frames = Array.from(document.querySelectorAll<HTMLElement>('[data-frame]'));
    const tail = document.querySelector<HTMLElement>('.next-wrap');
    if (frames.length === 0) return;

    /** The middle of the paper below the header: where a page comes to rest. */
    function reading() {
      const top = document.querySelector<HTMLElement>('.series-header')?.offsetHeight ?? 0;
      return window.scrollY + top + (window.innerHeight - top) / 2;
    }

    // Measured fresh on each turn, because photographs finish loading and the
    // page settles as you read. A side-by-side pair shares a vertical
    // position, so it counts as one page rather than two.
    function stops() {
      const out: number[] = [];
      for (const frame of frames) {
        const y = centreOf(frame);
        const last = out[out.length - 1];
        if (last !== undefined && Math.abs(last - y) < 8) continue;
        out.push(y);
      }
      return out;
    }

    const foot = () => document.documentElement.scrollHeight - window.innerHeight;
    const atFoot = () => tail !== null && window.scrollY >= foot() - 2;

    function turn(step: number) {
      const pages = stops();
      if (pages.length === 0) return;

      // Where you are. The line out to the next series sits past the last
      // photograph and cannot be centred — the page has nothing left to
      // scroll — so it counts as one page beyond the end rather than as a
      // position among them. Without that, stepping back from it would skip
      // the last photograph.
      let index = pages.length;
      if (!atFoot()) {
        const middle = reading();
        let best = Infinity;
        index = 0;
        pages.forEach((y, i) => {
          const distance = Math.abs(y - middle);
          if (distance < best) {
            best = distance;
            index = i;
          }
        });
      }

      const wanted = index + step;
      if (wanted < 0) return;

      if (wanted >= pages.length) {
        if (!tail || atFoot()) return;
        // The foot is not a photograph, so it is not in `pages` — reach it
        // through the same lifted-snap scroll everything else uses.
        centreOn(foot() + window.innerHeight);
        return;
      }

      centreOn(pages[wanted]);
    }

    // One photograph per gesture, turned the instant the gesture starts, and
    // never a queue: anything arriving while a turn is still gliding is
    // dropped rather than stacked up behind it.
    //
    // Telling one gesture from the next is the whole difficulty on a Mac. The
    // momentum after a flick goes on firing wheel events for a second or more
    // and is indistinguishable from a hand on the trackpad but for one thing:
    // momentum only ever decays. So a delta meaningfully bigger than the one
    // before it means fingers are back on the glass and a new page is wanted;
    // anything smaller is the tail of a swipe that has already had its page.
    //
    // Waiting for that tail to go quiet instead — which is what this did at
    // first — turns one page and then ignores you for a second and a bit,
    // which reads as the page being stuck.
    const glide = 400;
    let previous = 0;
    let turned = -Infinity;
    let settling = 0;

    function onWheel(event: WheelEvent) {
      // A pinch to zoom, and anything sideways, is not a page turn.
      if (event.ctrlKey) return;
      if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
      event.preventDefault();

      const delta = Math.abs(event.deltaY);

      // A moment's silence ends the gesture, so the next event — however
      // gentle, and a slow mouse wheel is very gentle — starts a fresh one.
      window.clearTimeout(settling);
      settling = window.setTimeout(() => {
        previous = 0;
      }, 120);

      // The margin over `previous` is there because momentum does not decay
      // perfectly smoothly, and a little jitter should not read as a hand.
      const hand = delta > previous * 1.15 + 1;
      previous = delta;
      if (!hand) return;

      // A gesture pushes several growing events before it peaks; only the
      // first of them turns a page.
      if (event.timeStamp - turned < glide) return;
      turned = event.timeStamp;
      turn(event.deltaY > 0 ? 1 : -1);
    }

    // The arrows turn pages too, in both axes: left and up go back, right and
    // down go on. Their native scroll is only a few dozen pixels, which the
    // snapping would undo on the spot.
    const forward = new Set(['ArrowRight', 'ArrowDown']);
    const back = new Set(['ArrowLeft', 'ArrowUp']);

    function onKey(event: KeyboardEvent) {
      const on = forward.has(event.key);
      if (!on && !back.has(event.key)) return;
      if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
      // Not always an element — a keypress with nothing focused targets the
      // document itself, which has no closest().
      const target = event.target;
      if (
        target instanceof Element &&
        target.closest('input, textarea, select, [contenteditable]')
      ) {
        return;
      }

      event.preventDefault();
      turn(on ? 1 : -1);
    }

    window.addEventListener('wheel', onWheel, { passive: false });
    document.addEventListener('keydown', onKey);
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('wheel', onWheel);
        document.removeEventListener('keydown', onKey);
        window.clearTimeout(settling);
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', startCounter);
  document.addEventListener('astro:page-load', startRail);
  document.addEventListener('astro:page-load', startPaging);
</script>
