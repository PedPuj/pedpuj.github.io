---
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  /** Page title, placed before the wordmark. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Page ground colour. Japan series pages use the cooler near-white. */
  ground?: string;
  /** Series accent. null = no accent hue; falls back to ink. */
  accent?: string | null;
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  ground = '#F5F2EC',
  accent = null,
  bodyClass = '',
} = Astro.props;

const fullTitle = title ? `${title} — ${site.wordmark}` : site.wordmark;
const vars = `--ground: ${ground}; --accent: ${accent ?? 'var(--ink)'};`;
---

<html lang="en" style={vars}>
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: without it iOS letterboxes the whole page inside
         the safe area, so a full-bleed photograph stops short of the Dynamic
         Island and the bottom edge. The chrome keeps clear on its own, via
         the --safe-* tokens. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- The typefaces are this site's own now (see global.css). Preloaded so
         the browser starts fetching them while it is still reading the head,
         rather than waiting to discover them in the stylesheet. The Latin
         Extended cut of the mono is deliberately not preloaded: it is only
         reached if a metadata line ever needs it. -->
    <link
      rel="preload"
      href="/fonts/switzer-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/switzer-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plex-mono-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<script>
  /** Already here: show it now, with no fade at all. */
  function showAtOnce(img: HTMLImageElement) {
    img.style.transition = 'none';
    img.classList.add('is-loaded');
    void img.offsetWidth;
    img.style.transition = '';
  }

  // Every photograph fades in over 400ms once it is actually decoded.
  // No spinner, no skeleton: the flat block behind it is the loading state.
  //
  // But only a photograph that genuinely took a moment to arrive. One that
  // comes straight back out of the cache is shown at once — otherwise
  // closing a photograph and landing where you were reading blanks the
  // picture you were looking at a second ago and dissolves it back in, which
  // looks for all the world like the page reloading. That is why closing the
  // *first* photograph never did it: its frame is the one loaded eagerly, so
  // it was always complete by the time this ran, while every other frame on
  // the page is lazy and had to be fetched again on arrival.
  function fadeIn(img: HTMLImageElement) {
    if (img.dataset.faded === 'true') return;
    img.dataset.faded = 'true';

    if (img.complete && img.naturalWidth > 0) {
      showAtOnce(img);
      return;
    }

    const asked = performance.now();
    const done = () => {
      if (performance.now() - asked < 150) showAtOnce(img);
      else img.classList.add('is-loaded');
    };
    img.addEventListener('load', done, { once: true });
    img.addEventListener('error', done, { once: true });
  }

  function run() {
    document.querySelectorAll<HTMLImageElement>('img[data-fade]').forEach(fadeIn);
  }

  run();
  document.addEventListener('astro:page-load', run);

  // Closing a photograph should put you back where you were reading, not at
  // the top. The full-screen view is a real route, so returning from it is a
  // forward navigation and Astro quite correctly scrolls to top. Remember the
  // position of the page a frame was opened from, and restore it on the way
  // back. Doing it this way rather than history.back() means it still works
  // after arrowing through several frames first.
  let cameFrom: string | null = null;
  let navType: string | null = null;

  const key = (path: string) => `bedro:scroll:${path}`;
  const isFrame = (path: string) => path.startsWith('/frame/');

  document.addEventListener('astro:before-preparation', (event) => {
    const e = event as unknown as { from: URL; to: URL; navigationType: string };
    cameFrom = e.from.pathname;
    navType = e.navigationType;
    if (!isFrame(cameFrom)) {
      try {
        sessionStorage.setItem(key(cameFrom), String(window.scrollY));
      } catch {
        /* private browsing, or storage is full — not worth failing over */
      }
    }
  });

  document.addEventListener('astro:after-swap', () => {
    // Real back/forward already restores scroll; don't fight it.
    if (navType === 'traverse') return;
    if (!cameFrom || !isFrame(cameFrom)) return;
    if (isFrame(location.pathname)) return;

    // The photograph you were just looking at is the one you are about to be
    // looking at again. It is in the cache, but its frame is marked lazy, so
    // left alone the browser does not begin to think about it until layout
    // has settled — easily long enough to show the empty block first.
    const returning = document.querySelector<HTMLImageElement>(
      `a[href="${cameFrom}"] img`,
    );
    if (returning) {
      returning.loading = 'eager';
      returning.decoding = 'sync';
      returning.setAttribute('fetchpriority', 'high');
    }

    let stored: string | null = null;
    try {
      stored = sessionStorage.getItem(key(location.pathname));
    } catch {
      /* see above */
    }
    if (stored === null) return;
    const y = Number(stored);

    // A scroll set by hand and a mandatory snap container disagree on some
    // browsers: the position is taken, then quietly corrected a frame or two
    // later, which is the page appearing to jump on arrival. Lift the
    // snapping across the restore, and put it back once the position holds.
    const root = document.documentElement;
    root.style.setProperty('scroll-snap-type', 'none');
    window.scrollTo(0, y);
    requestAnimationFrame(() => {
      if (Math.abs(window.scrollY - y) > 1) window.scrollTo(0, y);
      root.style.removeProperty('scroll-snap-type');
    });
  });
</script>
