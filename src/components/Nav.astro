---
interface Props {
  /** true when the nav sits over a photograph (homepage only). */
  onPhoto?: boolean;
}
const { onPhoto = false } = Astro.props;

const items = [
  { label: 'Work', href: '/work/' },
  { label: 'Loose', href: '/loose/' },
  { label: 'About', href: '/about/' },
];
---

<nav
  class:list={['nav', { 'on-photo': onPhoto }]}
  data-nav
  transition:persist={onPhoto ? 'nav-photo' : 'nav-paper'}
>
  {
    items.map((item) => (
      <a href={item.href} data-astro-prefetch="hover">
        {item.label}
      </a>
    ))
  }
  {!onPhoto && <span class="underline" data-underline aria-hidden="true"></span>}
</nav>

<style>
  .nav {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 30px;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 13px;
    line-height: 1;
  }

  .nav a {
    color: var(--ink-2);
    transition: color 150ms ease;
  }

  .nav a:hover,
  .nav a:focus-visible,
  .nav a[data-active] {
    color: var(--ink);
  }

  /* Hovering draws a 1px rule beneath the item, left to right, in the accent
     — the same gesture the series index rows and the next-series line use,
     and the same mark the active item already wears. The active item is
     skipped, since it has one of its own that slides. */
  .nav a {
    position: relative;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 200ms ease;
  }

  .nav a:hover::after,
  .nav a:focus-visible::after {
    width: 100%;
  }

  .nav a[data-active]::after {
    content: none;
  }

  /* Over a photograph, in the colours that ground allows: the items rest a
     little under full paper and the rule is drawn in paper too, since the
     accent is ink here and would vanish into the photograph. */
  .on-photo a {
    color: color-mix(in srgb, var(--paper) 76%, transparent);
  }

  .on-photo a:hover,
  .on-photo a:focus-visible {
    color: var(--paper);
  }

  .on-photo a::after {
    background: var(--paper);
  }

  .underline {
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 0;
    height: 1px;
    opacity: 0;
    background: var(--accent);
    transition:
      left 200ms ease,
      width 200ms ease,
      opacity 200ms ease,
      background-color 200ms ease;
  }

  @media (max-width: 768px) {
    .nav {
      gap: 18px;
    }
  }
</style>

<script>
  function paint(nav: HTMLElement) {
    const bar = nav.querySelector<HTMLElement>('[data-underline]');
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
    const path = location.pathname;

    let active: HTMLAnchorElement | null = null;
    for (const link of links) {
      const base = new URL(link.href).pathname.replace(/\/$/, '');
      const on = base !== '' && path.startsWith(base);
      link.toggleAttribute('data-active', on);
      if (on) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
      if (on) active = link;
    }

    if (!bar) return;

    // The very first placement has nowhere to slide from, so the rule is put
    // in position silently and then faded in. Arriving from the homepage —
    // which builds a fresh nav, and so always lands here — therefore takes
    // the same 200ms as sliding between two paper pages, instead of popping.
    const first = nav.dataset.painted !== 'true';
    if (first) {
      bar.style.transition = 'none';
      bar.style.opacity = '0';
    }

    if (active) {
      bar.style.left = `${active.offsetLeft}px`;
      bar.style.width = `${active.offsetWidth}px`;
    } else {
      bar.style.width = '0px';
    }

    if (first) {
      void bar.offsetWidth; // flush, so the fade below actually animates
      bar.style.transition = '';
      nav.dataset.painted = 'true';
    }

    bar.style.opacity = active ? '1' : '0';
  }

  function paintAll() {
    document.querySelectorAll<HTMLElement>('[data-nav]').forEach(paint);
  }

  document.addEventListener('astro:page-load', paintAll);
  window.addEventListener('resize', paintAll);
  // The underline is measured from text width, so re-measure once the
  // real typeface has replaced the fallback.
  if (document.fonts) document.fonts.ready.then(paintAll);
</script>
