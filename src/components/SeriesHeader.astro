---
import Wordmark from './Wordmark.astro';
import type { Series } from '../data/catalog';
import { counterText } from '../data/catalog';

interface Props {
  series: Series;
}
const { series } = Astro.props;
const start = counterText(1, series.frameCount);
---

<header class="series-header">
  <Wordmark />
  <span class="series-title">{series.title}</span>
  <span class="counter mono" data-counter data-total={series.frameCount}>
    <span class="counter-place" data-counter-place></span><span data-counter-num>{start}</span>
  </span>
</header>

<style>
  .series-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: baseline;
    height: calc(var(--series-header-h) + var(--safe-top));
    padding: calc(var(--chrome-top) + var(--safe-top))
      calc(var(--margin) + var(--safe-right)) 0
      calc(var(--margin) + var(--safe-left));
    /* Translucent paper. No border, no shadow, no solid bar. */
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    -webkit-backdrop-filter: none;
  }

  .series-title {
    margin-left: 120px;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 15px;
    line-height: 1;
    color: var(--ink);
  }

  .counter {
    margin-left: auto;
    font-size: 12px;
    /* Overrides .mono's 1.7 so the counter shares the wordmark's baseline. */
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    transition: color 200ms ease;
  }

  /* Where you are, when the series is a journey. It appears as you cross
     into a city and stays until you cross into the next one. */
  .counter-place {
    color: var(--ink-2);
    transition: opacity 250ms ease;
  }

  .counter-place:empty {
    opacity: 0;
  }

  /* Mobile header is wordmark and counter only. */
  @media (max-width: 768px) {
    .series-title {
      display: none;
    }
    .counter {
      font-size: 11px;
    }
  }
</style>
