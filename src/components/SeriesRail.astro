---
// ─────────────────────────────────────────────────────────────
//  The itinerary, in the left margin: five words, set on their
//  end. The city you are reading is inked and the rest are a
//  whisper, so the whole route is there without anything on the
//  page competing with a photograph. Each one is a link to where
//  that city begins.
//
//  No line, no marks, no ornament — the counter in the corner
//  already says how far in you are, so this only has to say
//  where. Desktop only: a phone has no margin to spare.
// ─────────────────────────────────────────────────────────────
import type { Series } from '../data/catalog';

interface Props {
  series: Series;
}
const { series } = Astro.props;
---

<nav class="rail" aria-label={`Cities in ${series.title}`}>
  {
    series.chapters.map((chapter) => (
      <a
        class="city mono"
        href={`#f${chapter.from}`}
        data-place={chapter.place}
        data-goto={chapter.from}
      >
        {chapter.name}
      </a>
    ))
  }
</nav>

<style>
  .rail {
    position: fixed;
    /* Centred in the 64px margin, so there is as much paper between the
       names and a full-measure photograph as there is to the page edge. */
    left: calc(var(--safe-left) + 23px);
    top: 50%;
    transform: translateY(-50%);
    z-index: 9;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Even air between them. Spacing them by how many frames each city
       holds would only be the old rail again, in another costume. */
    gap: 26px;
  }

  /* Read downwards, like the spine of a book — and, more to the point,
     narrow enough that nothing ever reaches across onto a photograph. */
  .city {
    writing-mode: vertical-rl;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--ink) 20%, transparent);
    transition: color 250ms ease;
    outline-offset: 3px;
  }

  .city.is-current {
    color: var(--ink);
  }

  .city:hover,
  .city:focus-visible {
    color: var(--ink);
  }

  /* No margin to stand in, or no height to stand up in. */
  @media (max-width: 1024px), (max-height: 620px) {
    .rail {
      display: none;
    }
  }
</style>
