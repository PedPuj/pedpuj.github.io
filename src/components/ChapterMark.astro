---
// ─────────────────────────────────────────────────────────────
//  The journey moving on, said in one line: a rule across the
//  measure, the city in its own script and in ours, and the
//  frames it covers out at the far edge.
//
//  It is deliberately small. It sits just above the first
//  photograph of the city rather than taking a screen of its
//  own, so arriving somewhere new costs you nothing — you read
//  the name and the picture together.
// ─────────────────────────────────────────────────────────────
import type { Chapter } from '../data/catalog';

interface Props {
  chapter: Chapter;
}
const { chapter } = Astro.props;
---

<section
  class="chapter"
  data-chapter={chapter.index}
  data-place={chapter.place}
  data-ground={chapter.ground ?? ''}
  aria-label={chapter.name}
>
  <span class="rule" aria-hidden="true"></span>

  <div class="line">
    <h2 class="name">
      {chapter.local && <span class="local" aria-hidden="true">{chapter.local}</span>}
      {chapter.name}
    </h2>
    <p class="mono range">{chapter.rangeLine}</p>
  </div>
</section>

<style>
  .chapter {
    /* Spans the full measure, unlike the photographs, which are centred on
       their own width. The rule is what makes the break read as a break. */
    align-self: stretch;
    width: 100%;
  }

  .rule {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--hairline);
    margin-bottom: 12px;
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: var(--gutter);
    width: 100%;
  }

  .name {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.2;
    color: var(--ink);
  }

  /* Small enough now to carry more of the accent without shouting. */
  .local {
    font-size: 28px;
    line-height: 1;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--accent) 65%, transparent);
    user-select: none;
  }

  /* Pushed to the far edge of the measure, so the two ends of the line hold
     the width the photographs sit inside. */
  .range {
    margin-left: auto;
    color: var(--ink-2);
  }

  @media (max-width: 768px) {
    .rule {
      margin-bottom: 10px;
    }

    .name {
      font-size: 16px;
      gap: 9px;
    }

    .local {
      font-size: 22px;
    }
  }
</style>
