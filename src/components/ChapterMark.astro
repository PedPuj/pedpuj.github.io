---
// ─────────────────────────────────────────────────────────────
//  The page a photobook gives you when the journey moves on:
//  the city's own characters, large and pale, the name under
//  them, and the frames it covers set out to the right.
//  Nothing here is a link. It is a breath, not a control.
// ─────────────────────────────────────────────────────────────
import type { Chapter } from '../data/catalog';

interface Props {
  chapter: Chapter;
}
const { chapter } = Astro.props;
---

<section
  class="chapter"
  data-chapter={chapter.index}
  data-place={chapter.place}
  data-ground={chapter.ground ?? ''}
  aria-label={chapter.name}
>
  <span class="rule" aria-hidden="true"></span>

  {chapter.local && (
    <span class="local" aria-hidden="true">{chapter.local}</span>
  )}

  <div class="line">
    <h2 class="name">{chapter.name}</h2>
    <p class="mono range">{chapter.rangeLine}</p>
  </div>
</section>

<style>
  .chapter {
    /* Spans the full measure, unlike the photographs, which are centred on
       their own width. The rule is what makes the break read as a break. */
    align-self: stretch;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-top: 20px;
  }

  .rule {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--hairline);
    margin-bottom: 28px;
  }

  /* The one loud mark on the page — and it is still only a tint of the
     series accent on paper, never ink. */
  .local {
    display: block;
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(72px, 11vw, 150px);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--accent) 26%, transparent);
    margin-bottom: 18px;
    user-select: none;
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: var(--gutter);
    width: 100%;
  }

  .name {
    font-family: var(--sans);
    font-weight: 400;
    font-size: 38px;
    line-height: 1.1;
    color: var(--ink);
  }

  /* Pushed to the far edge of the measure, so the two ends of the line hold
     the width the photographs sit inside. */
  .range {
    margin-left: auto;
    color: var(--ink-2);
  }

  @media (max-width: 768px) {
    .chapter {
      padding-top: 0;
    }

    .rule {
      margin-bottom: 20px;
    }

    .local {
      font-size: clamp(56px, 20vw, 96px);
      margin-bottom: 12px;
    }

    .name {
      font-size: 26px;
    }

    /* Not enough measure to hold both ends apart on a phone. */
    .line {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .range {
      margin-left: 0;
    }
  }
</style>
