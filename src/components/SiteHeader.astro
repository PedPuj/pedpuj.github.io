---
import Wordmark from './Wordmark.astro';
import Nav from './Nav.astro';
---

<header class="site-header">
  <Wordmark />
  <Nav />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    /* Baseline, not centre: the wordmark and the nav are different sizes and
       must sit on one line — and it must be the same line the homepage uses. */
    align-items: baseline;
    justify-content: space-between;
    height: var(--header-h);
    padding: var(--chrome-top) var(--margin) 0;
    background: var(--ground);
  }
</style>
