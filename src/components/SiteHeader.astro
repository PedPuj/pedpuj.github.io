---
import Wordmark from './Wordmark.astro';
import Nav from './Nav.astro';
---

<header class="site-header">
  <Wordmark />
  <Nav />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    /* Baseline, not centre: the wordmark and the nav are different sizes and
       must sit on one line — and it must be the same line the homepage uses. */
    align-items: baseline;
    justify-content: space-between;
    height: calc(var(--header-h) + var(--safe-top));
    padding: calc(var(--chrome-top) + var(--safe-top))
      calc(var(--margin) + var(--safe-right)) 0
      calc(var(--margin) + var(--safe-left));
    background: var(--ground);
  }
</style>
